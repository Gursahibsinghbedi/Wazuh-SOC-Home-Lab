<!--
  Custom Wazuh detection rules for this lab.
  Location on manager: /var/ossec/etc/rules/local_rules.xml
-->
<group name="local,syslog,sshd,">

  <!-- Rule 100102: SSH brute-force detection
       Fires when 3+ SSH authentication failures are seen from the same
       source within 60 seconds. Feeds the firewall-drop Active Response
       configured in ossec.conf (see configs/ossec.conf.active-response.xml). -->
  <rule id="100102" level="10" frequency="3" timeframe="60">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>Multiple SSH failed login attempts: 3 or more failures within 60 seconds</description>
    <group>authentication_failed,ssh,authentication,</group>
  </rule>

</group>
